{
    "name": "tailcloakify",
    "version": "1.2.12",
    "description": "Tailcloakify, the Keycloak Theme based on Keycloakify, and layered with TailwindCSS",
    "repository": {
        "type": "git",
        "url": "git@github.com:ALMiG-Kompressoren-GmbH/tailcloakify.git"
    },
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "build-keycloak-theme": "npm run build && keycloakify build",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "test:email-preview": "node --test .storybook/email-preview.test.mjs",
        "format": "prettier . --write",
        "clean-upstream-tags": "git tag -l \"v*\" | node -e \"const rl=require('readline').createInterface({input:process.stdin});const lines=[];rl.on('line',l=>lines.push(l));rl.on('close',()=>{const tags=lines.filter(t=>{const m=t.match(/^v(\\d+)\\.(\\d+)\\.(\\d+)/);return m&&+m[1]>=2});if(tags.length){console.log('Deleting local tags:',tags.join(', '));require('child_process').execSync('git tag -d '+tags.join(' '),{stdio:'inherit'});console.log('Deleting remote tags from origin...');require('child_process').execSync('git push origin '+tags.map(t=>':refs/tags/'+t).join(' '),{stdio:'inherit'})}else{console.log('No upstream tags to delete')}})\"",
        "pull-upstream": "git pull --no-tags upstream main && yarn clean-upstream-tags"
    },
    "license": "MIT",
    "keywords": [],
    "dependencies": {
        "@jsx-email/plugin-inline": "^2.0.0",
        "@jsx-email/plugin-minify": "^2.0.0",
        "@jsx-email/plugin-pretty": "^2.0.0",
        "autoprefixer": "^10.6.2",
        "i18next": "^27.1.3",
        "i18next-icu": "^2.7.0",
        "intl-messageformat": "^12.1.5",
        "jsx-email": "^3.2.1",
        "keycloakify": "^11.16.4",
        "keycloakify-emails": "^3.6.0",
        "postcss": "8.5.33",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^18.0.2",
        "tailwindcss": "^4.3.5",
        "vanilla-cookieconsent": "3.3.0"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^5.6.0",
        "@eslint/js": "^10.0.1",
        "@storybook/react": "^10.6.7",
        "@storybook/react-vite": "^10.6.7",
        "@tailwindcss/postcss": "4.3.5",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.72.2",
        "@typescript-eslint/parser": "^8.72.2",
        "@vitejs/plugin-react": "^6.3.0",
        "esbuild": "^0.25.2",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.8",
        "eslint-plugin-storybook": "^10.6.7",
        "globals": "^17.14.0",
        "mustache": "4.2.0",
        "prettier": "3.10.1",
        "storybook": "^10.6.7",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.72.2",
        "vite": "8.3.8"
    },
    "engines": {
        "node": "^18.0.0 || >=20.0.0"
    },
    "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
